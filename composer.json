{
  "name": "rivigor2/php-engineering-portfolio",
  "description": "Current PHP integration engineering, technical leadership, and selected past work.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Portfolio\\Commerce\\": "current-experience/ecommerce-marketplace/src/",
      "Portfolio\\DocumentFlow\\": "current-experience/b2b-document-flow/src/",
      "Portfolio\\CrmWorkflow\\": "current-experience/crm-workflow-backend/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Portfolio\\Commerce\\Tests\\": "current-experience/ecommerce-marketplace/tests/",
      "Portfolio\\DocumentFlow\\Tests\\": "current-experience/b2b-document-flow/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=256M",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
